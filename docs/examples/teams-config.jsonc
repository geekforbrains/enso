// Example ~/.enso/config.json for exact Slack routes.
//
// Slack requires routes.slack: exact DM users and channel IDs select one workspace
// and one access profile. There is no Slack allowlist, wildcard, or default route.
// An unrouted DM or explicit channel mention gets a fixed local access response
// without an LLM launch; ordinary unrouted channel messages are ignored.
// Telegram, when used instead, remains private and uses exact numeric IDs under
// transports.telegram.allowed_users plus the global working_dir.
//
// Config changes require an Enso restart. Before restarting, run:
//
//   enso config check
//   enso route explain slack U01OWNER
//   enso route explain slack U04CLIENT C0ACME
//
// config.json is strict JSON, so remove comments when copying this example.
{
  "transport": "slack",
  "transports": {
    "slack": {
      "bot_token": "xoxb-...",
      "app_token": "xapp-...",
      "bot_user_id": "UBOT000000",
      "notify_channel": "C0COMPANY"
    }
  },

  // A workspace is a provider cwd and shared content root, not a security
  // boundary. Both Acme channels below deliberately share one workspace.
  "workspaces": {
    "company": {
      "path": "~/.enso/workspaces/company",
      "concurrency": 1
    },
    "acme": {
      "path": "~/.enso/workspaces/clients/acme",
      "concurrency": 1
    }
  },

  // An access profile carries capabilities. Policy-controlled profiles point
  // at protected native CLI policy files outside all writable workspaces.
  "access": {
    "admin": {
      "unrestricted": true,
      "providers": ["claude", "codex", "agy"],
      "default_provider": "claude",
      "chat_commands": "*"
    },
    "staff": {
      "policy_dir": "~/.enso/policies/staff",
      "providers": ["claude", "codex"],
      "default_provider": "claude",
      "chat_commands": "*"
    },
    "client-readonly": {
      "policy_dir": "~/.enso/policies/client-readonly",
      "providers": ["claude"],
      "default_provider": "claude",
      "chat_commands": ["status", "clear", "stop", "help"]
    },
    "automation": {
      "policy_dir": "~/.enso/policies/automation",
      "providers": ["claude", "codex"],
      "default_provider": "claude",
      "chat_commands": []
    }
  },

  "routes": {
    "slack": {
      "account_id": "T0YOURTEAM",

      // DMs are keyed by exact Slack user ID. This authorizes only the owner.
      "dms": {
        "U01OWNER": {
          "workspace": "company",
          "access": "admin",
          "audit": false
        }
      },

      // Channels are keyed by exact channel ID. Every human member uses the
      // same route, even an administrator. Use a separate internal channel
      // for broader authority over the same project files.
      "channels": {
        "C0ACME": {
          "workspace": "acme",
          "access": "client-readonly",
          "audit": true
        },
        "C0ACMEINTERNAL": {
          "workspace": "acme",
          "access": "staff",
          "audit": false
        },
        "C0COMPANY": {
          "workspace": "company",
          "access": "staff",
          "audit": false
        }
      }
    }
  },

  "audit": {
    "on_failure": "block",
    "max_age_days": 365
  }
}

// Every ~/.enso/jobs/<name>/JOB.md separately declares both names, for example:
//
//   workspace: company
//   access: automation
//
// The job's provider runs in that workspace under that access profile's native
// policy. Missing or invalid bindings never fall back to unrestricted execution.
