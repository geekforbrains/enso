// Example resulting ~/.enso/config.json for exact Slack routes.
//
// Slack keeps credentials, options, and exact routes together under
// transports.slack. Exact DM users and channel IDs select one workspace and
// derive that workspace's policy. There is no allowlist, wildcard, or default route.
// Routed channels dispatch on @-mention by default; per-route mention_required
// and thread_mention_required relax that, with transports.slack.channel_defaults
// supplying defaults those per-route keys override. channel_defaults is
// settings inheritance, not a route: it authorizes no channel by itself. An
// unrouted DM or explicit channel mention gets a fixed local access response
// without an LLM launch; ordinary unrouted channel messages are ignored.
// Telegram, when used instead, remains private, uses exact numeric IDs under
// transports.telegram.allowed_users, and requires a workspace such as default;
// it derives that workspace's policy just like routes and jobs do.
// Rich messages and persistent surfaces require the current bundled Slack app
// manifest, including App Home, interactivity, canvases:write, and files:read.
//
// Do not create the policy or workspace catalog entries below by hand. Fresh
// setup creates only the full-authority unrestricted admin policy plus workspace
// default. First author, protect, and test every complete restricted
// provider-native directory, then register it with commands such as:
//
//   enso policy create staff --policy-dir ~/.enso/policies/staff \
//     --provider claude --provider codex --provider grok \
//     --default-provider claude \
//     --chat-command status --chat-command clear --chat-command stop \
//     --chat-command help --chat-command use --chat-command model \
//     --chat-command effort --chat-command compact \
//     --env-passthrough METRICS_API_TOKEN
//   enso policy create client-readonly \
//     --policy-dir ~/.enso/policies/client-readonly \
//     --provider claude --default-provider claude \
//     --chat-command status --chat-command clear --chat-command stop \
//     --chat-command help
//   enso policy create automation --policy-dir ~/.enso/policies/automation \
//     --provider claude --provider codex --default-provider claude
//
// The policy sources are user-owned. Enso never creates, copies, chmods,
// rewrites, upgrades, or repairs them. The acme-* files beside this example
// are explanatory starting points, not trusted or certified presets.
//
// Then create the name-derived workspaces through the workspace CLI:
//
//   enso workspace create company --policy staff
//   enso workspace create acme --policy client-readonly
//   enso workspace create acme-internal --policy staff
//   enso workspace create automation --policy automation
//
// Add the exact transport routes to the resulting config where no focused
// routing CLI exists. Config changes require an Enso restart. Before restarting,
// run:
//
//   enso policy list
//   enso policy show staff
//   enso config check
//   enso route explain slack U01OWNER
//   enso route explain slack U04CLIENT C0ACME
//
// config.json is strict JSON. Treat the body as a schema reference; if copying
// its transport or route fragments, remove comments first.
{
  "transport": "slack",
  "transports": {
    // Optional when Slack is active. If Telegram is configured, its workspace
    // is required and derives the same policy catalog used below.
    "telegram": {
      "bot_token": "...",
      "allowed_users": ["123456789"],
      "notify_channel": "123456789",
      "workspace": "default"
    },
    "slack": {
      "bot_token": "xoxb-...",
      "app_token": "xapp-...",
      "bot_user_id": "UBOT000000",
      "notify_channel": "C0COMPANY",

      // Both rich settings default to true; they are shown explicitly here.
      // Set persistent_surfaces false to keep rich replies without App Home or
      // Canvas drafts. Setting rich_messages false disables both rich paths.
      "rich_messages": true,
      "persistent_surfaces": true,

      "account_id": "T0YOURTEAM",

      // Response-trigger defaults for channel routes; per-route keys override
      // them, and an absent key falls back to the built-in true (mention-only).
      // Settings inheritance, not a route: this authorizes no channel. Here a
      // mention starts a thread and Enso then follows its replies.
      "channel_defaults": {
        "mention_required": true,
        "thread_mention_required": false
      },

      // DMs are keyed by exact Slack user ID. This authorizes only the owner.
      "dms": {
        "U01OWNER": {
          "workspace": "default",
          "audit": false
        }
      },

      // Channels are keyed by exact channel ID. Every human member uses the
      // same route, even an administrator. Use a separate internal channel
      // for broader authority over the same project files.
      "channels": {
        "C0ACME": {
          "workspace": "acme",
          "audit": true
        },
        "C0ACMEINTERNAL": {
          "workspace": "acme-internal",
          "audit": false
        },
        // Fully responsive override: false/false dispatches every top-level
        // message (replies always land in its thread) and follows joined
        // threads. true/true is mention-only; mixed values give the two
        // in-between modes.
        "C0COMPANY": {
          "workspace": "company",
          "audit": false,
          "mention_required": false,
          "thread_mention_required": false
        }
      }
    }
  },

  // A workspace is a provider cwd and shared content root. It selects exactly
  // one policy; the same policy may be reused by several workspaces. Names
  // derive only ~/.enso/workspaces/<name>; no path field is accepted.
  "workspaces": {
    "default": {
      "policy": "admin",
      "concurrency": 1
    },
    "company": {
      "policy": "staff",
      "concurrency": 1
    },
    "acme": {
      "policy": "client-readonly",
      "concurrency": 1
    },
    "acme-internal": {
      "policy": "staff",
      "concurrency": 1
    },
    "automation": {
      "policy": "automation",
      "concurrency": 1
    }
  },

  // These are the resulting entries written by policy create. A policy carries
  // capabilities; restricted policies explicitly point at existing protected
  // native CLI policy files outside all writable workspaces.
  "policies": {
    "admin": {
      "unrestricted": true,
      "providers": ["claude", "codex", "grok", "agy"],
      "default_provider": "claude",
      "chat_commands": "*"
    },
    // Service-wide commands (update, logs) stay on the unrestricted admin
    // policy; staff gets everything else explicitly rather than "*".
    "staff": {
      "policy_dir": "~/.enso/policies/staff",
      "providers": ["claude", "codex", "grok"],
      "default_provider": "claude",
      "chat_commands": ["status", "clear", "stop", "help", "use", "model", "effort", "compact"],

      // Names, never values: each variable is copied from the service
      // environment (e.g. loaded from ~/.enso/secrets/*.env at startup)
      // into the child environment. Invalid on an unrestricted policy.
      // See docs/specs/permissions.md for the MCP pairing and cautions.
      "env_passthrough": ["METRICS_API_TOKEN"]
    },
    "client-readonly": {
      "policy_dir": "~/.enso/policies/client-readonly",
      "providers": ["claude"],
      "default_provider": "claude",
      "chat_commands": ["status", "clear", "stop", "help"]
    },
    "automation": {
      "policy_dir": "~/.enso/policies/automation",
      "providers": ["claude", "codex"],
      "default_provider": "claude",
      "chat_commands": []
    }
  },

  "audit": {
    "on_failure": "block",
    "max_age_days": 365
  }
}

// Every ~/.enso/jobs/<name>/JOB.md declares its workspace, for example:
//
//   workspace: automation
//
// The job's provider runs under the workspace policy's native
// policy. Missing or invalid bindings never fall back to unrestricted execution.
