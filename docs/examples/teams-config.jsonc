// Example ~/.enso/config.json for Slack teams mode.
//
// The presence of routes.slack enables teams mode. Remove the legacy Slack
// allowed_users key: exact DM users and channel IDs become the authorization
// boundary. An unrouted DM or explicit channel mention gets a fixed local access
// response without an LLM launch; ordinary unrouted channel messages are ignored.
// Telegram keeps its existing allowlist and working_dir.
//
// Config changes require an Enso restart. Before restarting, run:
//
//   enso policy check
//   enso route explain slack U01OWNER
//   enso route explain slack U04CLIENT C0ACME
//
// config.json is strict JSON, so remove comments when copying this example.
{
  "transport": "slack",
  "transports": {
    "slack": {
      "bot_token": "xoxb-...",
      "app_token": "xapp-...",
      "bot_user_id": "UBOT000000"
    }
  },

  // A workspace is only a cwd containing shared knowledge, instructions, and
  // native skills. Both Acme channels below deliberately share one workspace.
  "workspaces": {
    "company": {
      "path": "~/.enso/workspaces/company",
      "concurrency": 1
    },
    "acme": {
      "path": "~/.enso/workspaces/clients/acme",
      "concurrency": 1
    }
  },

  // An access profile carries capabilities. Policy-controlled profiles point
  // at protected native CLI policy files outside all writable workspaces.
  "access": {
    "admin": {
      "unrestricted": true,
      "providers": ["claude", "codex", "agy"],
      "default_provider": "claude",
      "chat_commands": "*"
    },
    "staff": {
      "policy_dir": "~/.enso/policies/staff",
      "providers": ["claude", "codex"],
      "default_provider": "claude",
      "chat_commands": "*"
    },
    "client-readonly": {
      "policy_dir": "~/.enso/policies/client-readonly",
      "providers": ["claude"],
      "default_provider": "claude",
      "chat_commands": ["status", "clear", "stop", "help"]
    }
  },

  "routes": {
    "slack": {
      "account_id": "T0YOURTEAM",

      // DMs are keyed by exact Slack user ID. This authorizes only the owner.
      "dms": {
        "U01OWNER": {
          "workspace": "company",
          "access": "admin",
          "audit": false
        }
      },

      // Channels are keyed by exact channel ID. Every human member uses the
      // same route, even an administrator. Use a separate internal channel
      // for broader authority over the same project files.
      "channels": {
        "C0ACME": {
          "workspace": "acme",
          "access": "client-readonly",
          "audit": true
        },
        "C0ACMEINTERNAL": {
          "workspace": "acme",
          "access": "staff",
          "audit": false
        },
        "C0COMPANY": {
          "workspace": "company",
          "access": "staff",
          "audit": false
        }
      }
    }
  },

  "audit": {
    "on_failure": "block",
    "max_age_days": 365
  }
}
